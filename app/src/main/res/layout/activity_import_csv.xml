<!-- Importar movimientos de un archivo CSV: cuenta de destino y qué columna es cada dato -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="?attr/barColor"
            android:minHeight="?attr/actionBarSize"
            android:theme="?attr/actionBarTheme"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="104dp">

            <TextView
                    android:id="@+id/fileInfo"
                    style="@style/FormHint"
                    android:layout_marginTop="0dp" />

            <com.sanabria.vester.tools.DropdownField
                    android:id="@+id/accountField"
                    style="@style/FormDropdown"
                    android:layout_marginTop="16dp"
                    android:hint="@string/import_account" />

            <com.sanabria.vester.tools.DropdownField
                    android:id="@+id/dateColumn"
                    style="@style/FormDropdown"
                    android:hint="@string/import_col_date" />

            <com.sanabria.vester.tools.DropdownField
                    android:id="@+id/amountColumn"
                    style="@style/FormDropdown"
                    android:hint="@string/import_col_amount" />

            <com.sanabria.vester.tools.DropdownField
                    android:id="@+id/conceptColumn"
                    style="@style/FormDropdown"
                    android:hint="@string/import_col_concept" />

            <com.sanabria.vester.tools.DropdownField
                    android:id="@+id/categoryColumn"
                    style="@style/FormDropdown"
                    android:hint="@string/import_col_category" />

            <com.sanabria.vester.tools.DropdownField
                    android:id="@+id/noteColumn"
                    style="@style/FormDropdown"
                    android:hint="@string/import_col_note" />

            <TextView
                    android:id="@+id/preview"
                    style="@style/FormHint"
                    android:textColor="?android:attr/textColorPrimary" />

            <TextView
                    style="@style/FormHint"
                    android:text="@string/import_hint" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/importFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/import_action"
            app:icon="@drawable/ic_m_check"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
