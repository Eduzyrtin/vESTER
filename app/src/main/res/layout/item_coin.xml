<!-- Una moneda o billete del contador: valor, cuántos hay y botones para sumar o restar -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        app:cardBackgroundColor="?attr/cardBackgroundColor"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

        <View
                android:id="@+id/coinStrip"
                android:layout_width="6dp"
                android:layout_height="0dp"
                android:background="@color/colorAccent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        <TextView
                android:id="@+id/coinValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@+id/coinStrip"
                app:layout_constraintEnd_toEndOf="parent" />

        <TextView
                android:id="@+id/coinSubtotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                app:layout_constraintTop_toBottomOf="@+id/coinValue"
                app:layout_constraintStart_toStartOf="@+id/coinValue"
                app:layout_constraintEnd_toEndOf="parent" />

        <Button
                android:id="@+id/coinMinus"
                style="@style/PillButton"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/coin_remove"
                android:text="@string/minus_sign"
                android:textSize="20sp"
                app:layout_constraintTop_toBottomOf="@+id/coinSubtotal"
                app:layout_constraintStart_toStartOf="@+id/coinValue" />

        <TextView
                android:id="@+id/coinCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="24sp"
                app:layout_constraintTop_toTopOf="@+id/coinMinus"
                app:layout_constraintBottom_toBottomOf="@+id/coinMinus"
                app:layout_constraintStart_toEndOf="@+id/coinMinus"
                app:layout_constraintEnd_toStartOf="@+id/coinPlus" />

        <Button
                android:id="@+id/coinPlus"
                style="@style/PillButton"
                android:contentDescription="@string/coin_add"
                android:text="@string/plus_sign"
                android:textSize="20sp"
                app:layout_constraintTop_toTopOf="@+id/coinMinus"
                app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
