<!-- Ajustes de la app: apariencia, importes, privacidad, presupuestos y datos -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".SettingsActivity">

    <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="?attr/barColor"
            android:minHeight="?attr/actionBarSize"
            android:theme="?attr/actionBarTheme"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="32dp">

            <TextView
                    style="@style/FormSection"
                    android:text="@string/settings_appearance" />

            <TextView
                    style="@style/FormCaption"
                    android:text="@string/settings_theme" />

            <com.google.android.material.chip.ChipGroup
                    android:id="@+id/themeChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true" />

            <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/dynamicColorSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="56dp"
                    android:text="@string/dynamic_color"
                    android:textAppearance="@style/TextAppearance.App.Body" />

            <TextView
                    style="@style/FormSection"
                    android:text="@string/settings_amounts" />

            <TextView
                    style="@style/FormCaption"
                    android:text="@string/settings_input_hint" />

            <com.google.android.material.chip.ChipGroup
                    android:id="@+id/inputChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true" />

            <TextView
                    style="@style/FormSection"
                    android:text="@string/settings_privacy" />

            <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/lockSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="56dp"
                    android:text="@string/settings_lock"
                    android:textAppearance="@style/TextAppearance.App.Body" />

            <TextView
                    android:id="@+id/lockHint"
                    style="@style/FormHint"
                    android:layout_marginTop="0dp"
                    android:text="@string/settings_lock_unavailable"
                    android:visibility="gone" />

            <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/discreetSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:text="@string/settings_discreet"
                    android:textAppearance="@style/TextAppearance.App.Body" />

            <TextView
                    style="@style/FormHint"
                    android:layout_marginTop="0dp"
                    android:text="@string/settings_discreet_hint" />

            <TextView
                    style="@style/FormSection"
                    android:text="@string/categories" />

            <com.sanabria.vester.tools.DropdownField
                    android:id="@+id/monthStartField"
                    style="@style/FormDropdown"
                    android:layout_marginTop="12dp"
                    android:hint="@string/settings_month_start" />

            <TextView
                    style="@style/FormHint"
                    android:layout_marginTop="0dp"
                    android:text="@string/settings_month_start_hint" />

            <!-- Cambio de moneda: solo se ve si hay cuentas en monedas distintas -->
            <LinearLayout
                    android:id="@+id/currencySection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                <TextView
                        style="@style/FormSection"
                        android:text="@string/settings_currencies" />

                <com.sanabria.vester.tools.DropdownField
                        android:id="@+id/mainCurrencyField"
                        style="@style/FormDropdown"
                        android:layout_marginTop="12dp"
                        android:hint="@string/settings_main_currency" />

                <LinearLayout
                        android:id="@+id/rateRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                <TextView
                        style="@style/FormHint"
                        android:layout_marginTop="0dp"
                        android:text="@string/settings_currencies_hint" />
            </LinearLayout>

            <TextView
                    style="@style/FormSection"
                    android:text="@string/settings_data" />

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/exportCsv"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/export_csv" />

            <TextView
                    style="@style/FormHint"
                    android:text="@string/export_csv_hint" />

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/importCsv"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/import_csv" />

            <TextView
                    style="@style/FormHint"
                    android:text="@string/import_csv_hint" />

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/exportPdf"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/export_pdf" />

            <TextView
                    style="@style/FormHint"
                    android:text="@string/export_pdf_hint" />

            <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/autoBackupSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="56dp"
                    android:text="@string/auto_backup"
                    android:textAppearance="@style/TextAppearance.App.Body" />

            <TextView
                    android:id="@+id/autoBackupStatus"
                    style="@style/FormHint"
                    android:layout_marginTop="0dp" />

            <LinearLayout
                    android:id="@+id/autoBackupButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/backupNow"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/backup_now" />

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/backupFolder"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/backup_change_folder" />
            </LinearLayout>

            <TextView
                    android:id="@+id/versionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="center"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
