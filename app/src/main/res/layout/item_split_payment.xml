<!-- Una cuenta que paga una parte del gasto: cuenta, importe y quitarla -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

    <com.sanabria.vester.tools.DropdownField
            android:id="@+id/rowAccount"
            style="@style/FormDropdown"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:hint="@string/select_account" />

    <com.google.android.material.textfield.TextInputLayout
            style="@style/FormInput"
            android:layout_width="120dp"
            android:layout_marginStart="8dp"
            android:hint="@string/value">

        <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/rowAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:digits="0123456789.,"
                android:importantForAutofill="no"
                android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <ImageButton
            android:id="@+id/rowRemove"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/remove"
            android:src="@drawable/ic_m_close" />
</LinearLayout>
