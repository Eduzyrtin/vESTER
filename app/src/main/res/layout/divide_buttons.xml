<!-- Botones para dividir un importe entre 2, 3, 4 o las partes que se quiera -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

    <Button
            android:id="@+id/divideBy2"
            style="@style/PillButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/divide_by_2" />

    <Button
            android:id="@+id/divideBy3"
            style="@style/PillButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/divide_by_3" />

    <Button
            android:id="@+id/divideBy4"
            style="@style/PillButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/divide_by_4" />

    <Button
            android:id="@+id/divideByN"
            style="@style/PillButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/divide_by_n" />
</LinearLayout>
